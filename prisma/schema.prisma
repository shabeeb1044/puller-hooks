generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  description      String?
  image            String?
  bannerImage      String?
  visible          Boolean       @default(true)
  sortOrder        Int           @default(0)
  menuLinkType     String        @default("page") // page | product | custom (legacy: section = custom)
  menuAnchor       String?       // Custom URL, path, or home section id when menuLinkType = custom
  menuProductId    String?       // Existing product when menuLinkType = product
  menuProduct      Product?      @relation("CategoryMenuProduct", fields: [menuProductId], references: [id], onDelete: SetNull)
  pageSubtitle     String?       // Section 01 eyebrow
  pageTitle        String?       // Section 01 heading
  pageLead         String?       // Section 01 description
  introSubtitle    String?       // Section 02 eyebrow
  introTitle       String?       // Section 02 heading
  productsSubtitle String?       // Products section eyebrow
  productsTitle    String?       // Products section heading
  productsLead     String?       // Products section description
  bannerTheme      String        @default("black") // yellow | black — Section 01
  introTheme       String        @default("black") // yellow | black — Section 02
  productsTheme    String        @default("black") // yellow | black — Section 03
  pageTheme        String        @default("black") // legacy; prefer per-section themes
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  subcategories    Subcategory[]
  products         Product[]
}

model Subcategory {
  id            String    @id @default(cuid())
  name          String
  slug          String
  description   String?
  image         String?
  bannerImage   String?
  visible       Boolean   @default(true)
  sortOrder     Int       @default(0)
  menuLinkType  String    @default("page") // page | product | custom
  menuAnchor    String?   // Custom URL / path / section id
  menuProductId String?
  menuProduct   Product?  @relation("SubcategoryMenuProduct", fields: [menuProductId], references: [id], onDelete: SetNull)
  pageTitle     String?
  pageLead      String?
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([categoryId, slug])
}

model Product {
  id            String       @id @default(cuid())
  name          String
  slug          String
  description   String?
  specifications String?     // JSON string array or text
  features      String?      // JSON string array or text
  image         String?
  imageAlt      String?
  imageHeight   Int?
  status        String       @default("draft") // published | draft
  layout        String       @default("horizontal") // horizontal | vertical
  sortOrder     Int          @default(0)
  ctaLabel      String?      @default("Inquiry now")
  ctaHref       String?      @default("/dealers#apply")
  searchTerms   String?
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  menuCategories    Category[]    @relation("CategoryMenuProduct")
  menuSubcategories Subcategory[] @relation("SubcategoryMenuProduct")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([categoryId, slug])
  @@index([status, sortOrder])
  @@index([subcategoryId])
}

model DealerInquiry {
  id           String   @id @default(cuid())
  company      String
  name         String
  email        String
  businessType String?
  country      String?
  phone        String?
  address      String?
  postalCode   String?
  city         String?
  website      String?
  interest     String?
  message      String?
  status       String   @default("new") // new | in_progress | completed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("DealerEnquiry")
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  topic     String?
  country   String?
  phone     String?
  message   String
  status    String   @default("new") // new | in_progress | completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("ContactEnquiry")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
