generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  description      String?       @db.Text
  image            String?       @db.Text
  bannerImage      String?       @db.Text
  visible          Boolean       @default(true)
  sortOrder        Int           @default(0)
  menuLinkType     String        @default("page") // page | product | custom (legacy: section = custom)
  menuAnchor       String?       @db.Text // Custom URL, path, or home section id when menuLinkType = custom
  menuProductId    String?       // Existing product when menuLinkType = product
  menuProduct      Product?      @relation("CategoryMenuProduct", fields: [menuProductId], references: [id], onDelete: SetNull)
  pageSubtitle     String?       // Section 01 eyebrow
  pageTitle        String?       // Section 01 heading
  pageLead         String?       @db.Text // Section 01 description
  introSubtitle    String?       // Section 02 eyebrow
  introTitle       String?       // Section 02 heading
  productsSubtitle String?       // Products section eyebrow
  productsTitle    String?       // Products section heading
  productsLead     String?       @db.Text // Products section description
  bannerTheme      String        @default("black") // yellow | black — Section 01
  introTheme       String        @default("black") // yellow | black — Section 02
  productsTheme    String        @default("black") // yellow | black — Section 03
  pageTheme        String        @default("black") // legacy; prefer per-section themes
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  subcategories    Subcategory[]
  products         Product[]
}

model Subcategory {
  id               String    @id @default(cuid())
  name             String
  slug             String
  description      String?   @db.Text // legacy; prefer modelsLead
  image            String?   @db.Text // not used on subcategory page layout
  bannerImage      String?   @db.Text
  visible          Boolean   @default(true)
  sortOrder        Int       @default(0)
  menuLinkType     String    @default("page") // page | product | custom
  menuAnchor       String?   @db.Text // Custom URL / path / section id
  menuProductId    String?
  menuProduct      Product?  @relation("SubcategoryMenuProduct", fields: [menuProductId], references: [id], onDelete: SetNull)
  pageSubtitle     String?   // Section 01 eyebrow
  pageTitle        String?   // Section 01 heading
  pageLead         String?   @db.Text // Section 01 description
  modelsSubtitle   String?   // Section 02 Available Models eyebrow
  modelsTitle      String?   // Section 02 heading
  modelsLead       String?   @db.Text // Section 02 description
  productsSubtitle String?   // Section 03 Products eyebrow
  productsTitle    String?   // Section 03 heading
  productsLead     String?   @db.Text // Section 03 description
  bannerTheme      String    @default("black") // yellow | black — Section 01
  modelsTheme      String    @default("black") // yellow | black — Section 02
  productsTheme    String    @default("black") // yellow | black — Section 03
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products         Product[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([categoryId, slug])
}

model Product {
  id            String       @id @default(cuid())
  name          String
  slug          String
  description    String?      @db.Text
  specifications String?      @db.Text // JSON string array or text
  features       String?      @db.Text // JSON string array or text
  image          String?      @db.Text
  imageAlt       String?
  imageHeight    Int?
  imageStyle     String       @default("contain") // contain | vertical — how image cards display
  status         String       @default("draft") // published | draft
  layout         String       @default("horizontal") // horizontal | vertical
  sortOrder      Int          @default(0)
  ctaLabel       String?      @default("Inquiry now")
  ctaHref        String?      @default("/dealers#apply") @db.Text
  searchTerms    String?      @db.Text
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  menuCategories    Category[]    @relation("CategoryMenuProduct")
  menuSubcategories Subcategory[] @relation("SubcategoryMenuProduct")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([categoryId, slug])
  @@index([status, sortOrder])
  @@index([subcategoryId])
}

model DealerInquiry {
  id           String   @id @default(cuid())
  company      String
  name         String
  email        String
  businessType String?
  country      String?
  phone        String?
  whatsapp     String?
  address      String?  @db.Text
  postalCode   String?
  city         String?
  website      String?  @db.Text
  interest     String?  @db.Text
  message      String?  @db.Text
  status       String   @default("new") // new | in_progress | completed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("DealerEnquiry")
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  topic     String?
  country   String?
  phone     String?
  whatsapp  String?
  message   String   @db.Text
  status    String   @default("new") // new | in_progress | completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("ContactEnquiry")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Continent / area used by the public dealer directory region select.
model DealerRegion {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  sortOrder Int             @default(0)
  visible   Boolean         @default(true)
  dealers   DealerLocation[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([visible, sortOrder])
}

/// Authorized dealer listing shown on /dealers (name + address).
model DealerLocation {
  id        String       @id @default(cuid())
  name      String
  address   String       @db.Text
  country   String?
  sortOrder Int          @default(0)
  visible   Boolean      @default(true)
  regionId  String
  region    DealerRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([regionId, visible, sortOrder])
}
