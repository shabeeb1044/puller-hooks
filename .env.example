# Local MySQL (XAMPP / phpMyAdmin)
# Empty password: mysql://root@127.0.0.1:3306/puller_hooks
# With password:  mysql://root:YOUR_PASSWORD@127.0.0.1:3306/puller_hooks
DATABASE_URL="mysql://root@127.0.0.1:3306/puller_hooks"
AUTH_SECRET="generate-a-long-random-secret"

# Used only by prisma/seed.js on first setup — change after production deploy
ADMIN_SETUP_EMAIL="sales@pullertackle.com"
ADMIN_SETUP_PASSWORD="change-me-before-production"

# Admin header link (GOOGLE_SHEET_URL preferred; GOOGLE_SHEET also accepted)
GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"
# Apps Script web app URL — appends Contact/Dealer rows (see docs/GOOGLE-SHEET-APPS-SCRIPT.md)
GOOGLE_SHEET_WEBHOOK="https://script.google.com/macros/s/XXXX/exec"

# Form submission email notifications → sales@pullertackle.com business mailbox
SALES_EMAIL="sales@pullertackle.com"
MAIL_FROM="noreply@pullertackle.com"
# Local Postfix on VPS (no auth). For 587/465 submission, set user/pass + SMTP_SECURE=true for 465.
SMTP_HOST="127.0.0.1"
SMTP_PORT="25"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"
