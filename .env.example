DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-a-long-random-secret"

# Turso remote SQLite (required for production / Cloudflare)
# Leave empty locally to use DATABASE_URL file:./dev.db
TURSO_DATABASE_URL="libsql://YOUR-DB.turso.io"
TURSO_AUTH_TOKEN="your-turso-token"

# Used only by prisma/seed.js on first setup — change after production deploy
ADMIN_SETUP_EMAIL="sales@pullertackle.com"
ADMIN_SETUP_PASSWORD="change-me-before-production"
