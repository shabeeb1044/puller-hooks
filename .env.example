# Local MySQL (XAMPP / phpMyAdmin)
# Empty password: mysql://root@127.0.0.1:3306/puller_hooks
# With password:  mysql://root:YOUR_PASSWORD@127.0.0.1:3306/puller_hooks
DATABASE_URL="mysql://root@127.0.0.1:3306/puller_hooks"
AUTH_SECRET="generate-a-long-random-secret"

# Used only by prisma/seed.js on first setup — change after production deploy
ADMIN_SETUP_EMAIL="sales@pullertackle.com"
ADMIN_SETUP_PASSWORD="change-me-before-production"
